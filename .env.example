# Copy this file to .env and fill in your key. .env is loaded automatically
# by app.py (no python-dotenv dependency needed) — never commit your real .env.

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional — override the default model. Check https://openrouter.ai/models
# for what's currently available; the catalog changes over time.
# OPENROUTER_MODEL=openai/gpt-4o-mini
